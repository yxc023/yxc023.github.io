# Aliyun OSS credentials (used by `npm run deploy`)
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET=
# Optional: prefix for all keys (leave empty for root)
ALIYUN_OSS_PREFIX=

# Giscus (https://giscus.app/)
# 1. Enable Discussions on https://github.com/yxc023/yxc023.github.io
# 2. Visit https://giscus.app/ to fill the form, copy values below.
PUBLIC_GISCUS_REPO=yxc023/yxc023.github.io
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=General
PUBLIC_GISCUS_CATEGORY_ID=